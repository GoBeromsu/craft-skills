{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://craft-skills.local/schemas/init/transaction.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "transaction_id", "operation", "phase", "recovery_from_phase", "intended_snapshot_sha256", "snapshot", "targets"],
  "properties": {
    "schema_version": {"const": 1},
    "transaction_id": {"$ref": "#/$defs/hash"},
    "operation": {"enum": ["map", "prune"]},
    "phase": {"enum": ["preparing", "prepared", "applying-products", "products-applied", "committing-snapshot", "snapshot-committed", "cleaning", "recovery-required"]},
    "recovery_from_phase": {"anyOf": [{"type": "null"}, {"enum": ["preparing", "prepared", "applying-products", "products-applied", "committing-snapshot", "snapshot-committed", "cleaning"]}]},
    "intended_snapshot_sha256": {"$ref": "#/$defs/hash"},
    "snapshot": {"$ref": "#/$defs/target"},
    "targets": {"type": "array", "items": {"$ref": "#/$defs/target"}}
  },
  "allOf": [
    {"if": {"properties": {"phase": {"const": "recovery-required"}}}, "then": {"properties": {"recovery_from_phase": {"type": "string"}}}, "else": {"properties": {"recovery_from_phase": {"type": "null"}}}},
    {"properties": {"snapshot": {"properties": {"action": {"enum": ["create", "replace"]}}}}}
  ],
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "path": {"type": "string", "pattern": "^(?!/)(?!.*\\\\)(?!.*\\u0000)(?!.*(?:^|/)\\.{1,2}(?:/|$)).+"},
    "mode": {"type": "integer", "minimum": 0, "maximum": 4095},
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "action", "pre_exists", "pre_sha256", "pre_mode", "post_exists", "post_sha256", "post_mode", "pre_recovery_path", "post_recovery_path", "apply_path", "state"],
      "properties": {
        "path": {"$ref": "#/$defs/path"}, "action": {"enum": ["create", "replace", "delete"]},
        "pre_exists": {"type": "boolean"}, "pre_sha256": {"anyOf": [{"$ref": "#/$defs/hash"}, {"type": "null"}]}, "pre_mode": {"anyOf": [{"$ref": "#/$defs/mode"}, {"type": "null"}]},
        "post_exists": {"type": "boolean"}, "post_sha256": {"anyOf": [{"$ref": "#/$defs/hash"}, {"type": "null"}]}, "post_mode": {"anyOf": [{"$ref": "#/$defs/mode"}, {"type": "null"}]},
        "pre_recovery_path": {"anyOf": [{"$ref": "#/$defs/path"}, {"type": "null"}]}, "post_recovery_path": {"anyOf": [{"$ref": "#/$defs/path"}, {"type": "null"}]},
        "apply_path": {"$ref": "#/$defs/path"}, "state": {"enum": ["pending", "applying", "applied", "rolling-back", "rolled-back"]}
      },
      "allOf": [
        {"if": {"properties": {"pre_exists": {"const": true}}}, "then": {"properties": {"pre_sha256": {"$ref": "#/$defs/hash"}, "pre_mode": {"$ref": "#/$defs/mode"}, "pre_recovery_path": {"$ref": "#/$defs/path"}}}, "else": {"properties": {"pre_sha256": {"type": "null"}, "pre_mode": {"type": "null"}, "pre_recovery_path": {"type": "null"}}}},
        {"if": {"properties": {"post_exists": {"const": true}}}, "then": {"properties": {"post_sha256": {"$ref": "#/$defs/hash"}, "post_mode": {"$ref": "#/$defs/mode"}, "post_recovery_path": {"$ref": "#/$defs/path"}}}, "else": {"properties": {"post_sha256": {"type": "null"}, "post_mode": {"type": "null"}, "post_recovery_path": {"type": "null"}}}},
        {"if": {"properties": {"action": {"const": "create"}}}, "then": {"properties": {"pre_exists": {"const": false}, "post_exists": {"const": true}}}},
        {"if": {"properties": {"action": {"const": "replace"}}}, "then": {"properties": {"pre_exists": {"const": true}, "post_exists": {"const": true}}}},
        {"if": {"properties": {"action": {"const": "delete"}}}, "then": {"properties": {"pre_exists": {"const": true}, "post_exists": {"const": false}}}}
      ]
    }
  }
}
