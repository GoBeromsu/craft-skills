{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://craft-skills.local/schemas/init/snapshot.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "repository_root", "owned_artifacts", "last_applied_topology"],
  "properties": {"schema_version": {"const": 1}, "repository_root": {"const": "."}, "owned_artifacts": {"type": "array", "items": {"$ref": "#/$defs/owned"}}, "last_applied_topology": {"$ref": "#/$defs/topology"}},
  "$defs": {
    "path": {"type": "string", "pattern": "^(?!.*(?:^|/)\\.{1,2}(?:/|$))[^/\\\\\\u0000]+(?:/[^/\\\\\\u0000]+)*$"},
    "directory": {"anyOf": [{"const": "."}, {"$ref": "#/$defs/path"}]},
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "mode": {"type": "integer", "minimum": 0, "maximum": 4095},
    "owned": {"type": "object", "additionalProperties": false, "required": ["path", "artifact_type", "managed_id", "status", "payload_sha256", "file_sha256", "mode"], "properties": {"path": {"$ref": "#/$defs/path"}, "artifact_type": {"enum": ["agents-region", "agents-file", "claude-shim"]}, "managed_id": {"type": "string", "minLength": 1}, "status": {"enum": ["active", "stale"]}, "payload_sha256": {"anyOf": [{"$ref": "#/$defs/hash"}, {"type": "null"}]}, "file_sha256": {"anyOf": [{"$ref": "#/$defs/hash"}, {"type": "null"}]}, "mode": {"$ref": "#/$defs/mode"}}, "allOf": [{"if": {"properties": {"artifact_type": {"const": "agents-region"}}}, "then": {"properties": {"payload_sha256": {"$ref": "#/$defs/hash"}, "file_sha256": {"type": "null"}}}}, {"if": {"properties": {"artifact_type": {"const": "agents-file"}}}, "then": {"properties": {"payload_sha256": {"$ref": "#/$defs/hash"}, "file_sha256": {"$ref": "#/$defs/hash"}}}}, {"if": {"properties": {"artifact_type": {"const": "claude-shim"}}}, "then": {"properties": {"payload_sha256": {"type": "null"}, "file_sha256": {"$ref": "#/$defs/hash"}}}}]},
    "loader": {"type": "object", "additionalProperties": false, "required": ["loader_class", "evidence_status", "source_id", "runtime_version", "probe_fixture_sha256", "probe_result_sha256"], "properties": {"loader_class": {"enum": ["file-scoped", "recursive", "ancestor-only", "unknown"]}, "evidence_status": {"enum": ["probe-verified", "source-only", "conflicted", "unavailable", "version-mismatch", "not-automatable"]}, "source_id": {"anyOf": [{"type": "string", "minLength": 1}, {"type": "null"}]}, "runtime_version": {"anyOf": [{"type": "string", "minLength": 1}, {"type": "null"}]}, "probe_fixture_sha256": {"anyOf": [{"$ref": "#/$defs/hash"}, {"type": "null"}]}, "probe_result_sha256": {"anyOf": [{"$ref": "#/$defs/hash"}, {"type": "null"}]}}, "allOf": [{"if": {"properties": {"evidence_status": {"const": "probe-verified"}}}, "then": {}, "else": {"properties": {"loader_class": {"const": "unknown"}}}}]},
    "factor": {"type": "object", "additionalProperties": false, "required": ["name", "measured", "value", "points", "evidence_paths"], "properties": {"name": {"enum": ["file-count", "subdirectory-count", "code-ratio", "unique-patterns", "module-boundary", "symbol-density", "export-count", "reference-centrality"]}, "measured": {"type": "boolean"}, "value": {}, "points": {"type": "integer", "minimum": 0, "maximum": 3}, "evidence_paths": {"type": "array", "items": {"$ref": "#/$defs/path"}}}},
    "node": {"type": "object", "additionalProperties": false, "required": ["directory", "agents_path", "parent_agents_path", "managed_id", "score", "decision", "factors"], "properties": {"directory": {"$ref": "#/$defs/directory"}, "agents_path": {"$ref": "#/$defs/path"}, "parent_agents_path": {"anyOf": [{"$ref": "#/$defs/path"}, {"type": "null"}]}, "managed_id": {"type": "string", "minLength": 1}, "score": {"type": "integer", "minimum": 0, "maximum": 17}, "decision": {"enum": ["root", "high-score", "distinct-domain"]}, "factors": {"type": "array", "items": {"$ref": "#/$defs/factor"}}}},
    "coverage": {"type": "object", "additionalProperties": false, "required": ["directory", "expected_chain", "status_at_apply", "basis_at_apply"], "properties": {"directory": {"$ref": "#/$defs/directory"}, "expected_chain": {"type": "array", "items": {"$ref": "#/$defs/path"}}, "status_at_apply": {"enum": ["covered", "gap", "ambiguous", "unverified"]}, "basis_at_apply": {"enum": ["native", "root-fallback", "none"]}}},
    "topology": {"type": "object", "additionalProperties": false, "required": ["max_depth", "shim_policy", "loader", "nodes", "coverage", "root_fallback_payload_sha256"], "properties": {"max_depth": {"type": "integer", "minimum": 1, "maximum": 32}, "shim_policy": {"enum": ["on", "off"]}, "loader": {"$ref": "#/$defs/loader"}, "nodes": {"type": "array", "items": {"$ref": "#/$defs/node"}}, "coverage": {"type": "array", "items": {"$ref": "#/$defs/coverage"}}, "root_fallback_payload_sha256": {"anyOf": [{"$ref": "#/$defs/hash"}, {"type": "null"}]}}}
  }
}
